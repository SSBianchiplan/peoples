# GPlanSiS|Peoples — variáveis de ambiente. Copie para .env e preencha.
# Nada aqui vai para o repositório: .env está no .gitignore.

# --- Sessão e login próprio -------------------------------------------------
# Obrigatório quando ORG_EXIGIR_LOGIN=1 (32+ caracteres).
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Fecha o sistema: sem sessão válida, tudo redireciona para /login.
# Deixe vazio (ou 0) para manter o acesso aberto — o modo de trabalho de mesa.
ORG_EXIGIR_LOGIN=

# `secure` no cookie de sessão. Ligue em produção (HTTPS); em http://127.0.0.1
# o navegador descartaria o cookie.
ORG_COOKIE_SEGURO=

# Domínios aceitos no login (lista por vírgula). Vazio = qualquer um.
ORG_DOMINIOS=

# E-mail mostrado como exemplo no campo de login.
ORG_EMAIL_EXEMPLO=nome.sobrenome@gplansis.com

# Operadores do sistema: entram SEMPRE como Administrador total, em qualquer
# organograma (precisam de senha como todo mundo). Lista por vírgula.
ORG_SUPERADMINS=contato@gplansis.com

# Primeiro arranque: cria o administrador inicial quando ainda não existe
# NENHUM usuário (depois disso é ignorado). Alternativa à tela de primeiro
# acesso e à linha de comando `python -m orga.usuarios definir <e-mail>`.
ORG_ADMIN_EMAIL=
ORG_ADMIN_SENHA=

# Onde as credenciais moram (hash scrypt, nunca a senha). Padrão: dados/usuarios.json.
ORG_USUARIOS_ARQUIVO=

# --- Idioma de abertura ------------------------------------------------------
# pt-BR (padrão), en-US ou es. Fixa a língua a cada arranque.
ORG_IDIOMA=pt-BR

# --- Sincronização de centro de custo com o Microsoft 365 (opcional) --------
# Só para quem tem um tenant Microsoft 365: permissão de APLICATIVO
# `User.Read.All` com consentimento de administrador. Sem estes três, a aba
# Configurações › Microsoft 365 apenas explica o que faria. O organograma só lê.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Onde o MS365 guarda o centro de custo. Vazio = `department`; `costCenter`
# lê de employeeOrgData.
CC_ATTRIBUTE=

# --- PostgreSQL — a base de dados local -------------------------------------
# Com a URL definida e `psycopg` instalado, a aba Configurações › Banco de dados
# aplica de verdade, e com ORG_ESPELHO=1 TODA gravação desce para o banco:
# estrutura, ledger, configuração/colapso/filtros (org.estado_extra), os
# módulos (Skills, Conversa de Valor, Avaliação, Avaliação Mestre, One-on-One) e
# as credenciais do login (org.usuario). O estado.json continua sendo a queda.
#
# No VPS do hub o banco é o PostgreSQL 18 do host, por socket Unix e peer auth
# (o serviço roda como o usuário `peoples`, dono do banco `peoples`):
#   ORG_DATABASE_URL=postgresql:///peoples?host=/var/run/postgresql
ORG_DATABASE_URL=
ORG_ESPELHO=

# --- Lakehouse (base intermediária do hub) ----------------------------------
# O Peoples é DONO do banco `peoples` e CONSUMIDOR do lakehouse. São credenciais
# diferentes de propósito: aqui entra apenas a de LEITURA (papel `lake_leitor`,
# SELECT em gold/silver). Quem escreve no lakehouse é o ETL, noutro serviço e
# com outro usuário — nenhum sistema do hub escreve no banco de outro.
LAKE_LEITOR_DSN=

# Tokens de serviço que liberam `GET /api/v1/lake/*` máquina-a-máquina
# (Authorization: Bearer <token>), lista por vírgula. Sem tokens, a API do lake
# exige sessão como qualquer outra rota.
ORG_LAKE_TOKENS=

# --- Porta -----------------------------------------------------------------
# A mesma para o uvicorn, o healthcheck e o proxy (Caddy) na frente.
ORG_PORT=8400

# --- MarIA (IA / Anthropic) -------------------------------------------------
# Sem a chave o módulo abre e explica o que faria; só o chat fica indisponível.
ANTHROPIC_API_KEY=
# Padrão do sistema. Pode ser sobreposto na tela MarIA — Custos, e o que a tela
# grava é só o nome do modelo: a chave nunca sai do ambiente.
MARIA_MODEL=claude-haiku-4-5

# --- E-mail (SMTP) ----------------------------------------------------------
# O provisionamento de TI já sabe a quem avisar; isto é o carteiro. O módulo
# está pronto e liga sozinho quando SMTP_HOST e SMTP_DE aparecerem — até lá a
# fila na tela é a notificação. Falha de envio nunca derruba o pedido.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_DE=
SMTP_NOME=GPlanSiS|Peoples
# 1 força SSL direto (porta 465). Vazio = STARTTLS, que é o normal na 587.
SMTP_SSL=

# --- Só para o docker-compose.yml (Postgres do próprio compose) -------------
# Valores de exemplo: troque a senha antes de subir.
POSTGRES_USER=peoples
POSTGRES_DB=peoples
POSTGRES_PASSWORD=troque-esta-senha

# --- Revisão de texto (opcional) --------------------------------------------
# URL de um servidor LanguageTool próprio. Vazio = recurso desligado.
LANGUAGETOOL_URL=
